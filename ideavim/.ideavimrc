" IdeaVim configuration. The mappings mirror the NeoVim configuration (nvim/.config/nvim/README.md),
" so the same keys do the same things in both editors.

set number relativenumber
set idearefactormode=keep
set ideajoin
set surround
set easymotion
set which-key
set highlightedyank
set incsearch
set notimeout

" Plugin for commenting code
" gcc - comment current line
" gc - comment selection
" gc{motion} - comment to motion
set commentary

" Always yank to clipboard
set clipboard=unnamedplus

" Case-insensitive searching UNLESS \C or one or more capital letters in the search term
set ignorecase
set smartcase

" Minimal number of screen lines to keep above and below the cursor.
set scrolloff=15

let mapleader = " "

" --- General ---

" Line movement
nnoremap <A-j> :m +1<CR>
nnoremap <A-k> :m -2<CR>
inoremap <A-j> <Esc>:m +1<CR>gi
inoremap <A-k> <Esc>:m -2<CR>gi

" Navigate between editor splits
nnoremap <C-h> :action PrevSplitter<CR>
nnoremap <C-l> :action NextSplitter<CR>

nmap gt <action>(NextTab)
nmap gT <action>(PreviousTab)
nmap <C-w>c <action>(CloseEditor)

" File explorer (oil.nvim in NeoVim)
nmap - <action>(SelectInProjectView)
nmap <leader>e <action>(ActivateProjectToolWindow)

" IntelliJ only
nmap <leader>y "*yy
nmap <leader>p "*p
nmap <leader>P "*P
vmap <leader>p "*p
vmap <leader>P "*P
nmap <leader>x <action>(CloseEditor)
nmap <leader>z <action>(HideAllWindows)
nmap <leader>i <action>(Generate)

" --- Code navigation (LSP mappings in NeoVim) ---

nmap gd <action>(GotoDeclaration)
nmap gD <action>(GotoDeclaration)
nmap grr <action>(FindUsages)
nmap gri <action>(GotoImplementation)
nmap grt <action>(GotoTypeDeclaration)
nmap grn <action>(RenameElement)
nmap gra <action>(ShowIntentionActions)
vmap gra <action>(ShowIntentionActions)
nmap gO <action>(FileStructurePopup)
nmap K <action>(QuickJavaDoc)
nmap ]d <action>(GotoNextError)
nmap [d <action>(GotoPreviousError)
nmap <C-w>d <action>(ShowErrorDescription)
nmap <leader>q <action>(ActivateProblemsViewToolWindow)
nmap <leader>f <action>(ReformatCode)
nmap <leader>th <action>(ToggleInlayHintsGloballyAction)

" --- Search (Telescope in NeoVim) ---

nmap <leader>sh <action>(HelpTopics)
nmap <leader>sk <action>(Keymap)
nmap <leader>sf <action>(GotoFile)
nmap <leader>sg <action>(FindInPath)
nmap <leader>sc <action>(GotoSymbol)
nmap <leader>so <action>(FileStructurePopup)
nmap <leader>sp <action>(ReplaceInPath)
vmap <leader>sp <action>(ReplaceInPath)
nmap <leader>ss <action>(GotoAction)
nmap <leader>sw <action>(FindWordAtCaret)
nmap <leader>sd <action>(ActivateProblemsViewToolWindow)
nmap <leader>sr <action>(SearchEverywhere)
nmap <leader>sR :registers<CR>
nmap <leader>s. <action>(RecentFiles)
nmap <leader><leader> <action>(RecentFiles)
nmap <leader>/ <action>(Find)

" --- Java (<leader>J) ---

nmap <leader>Jg <action>(Generate)
nmap <leader>Jo <action>(OptimizeImports)
nmap <leader>Jv <action>(IntroduceVariable)
vmap <leader>Jv <action>(IntroduceVariable)
nmap <leader>JC <action>(IntroduceConstant)
vmap <leader>JC <action>(IntroduceConstant)
vmap <leader>Jm <action>(ExtractMethod)
nmap <leader>Js <action>(GotoSuperMethod)
nmap <leader>Jt <action>(DebugClass)
nmap <leader>JT <action>(DebugClass)
nmap <leader>Jp <action>(ChooseDebugConfiguration)
nmap <leader>Ju <action>(Maven.Reimport)
nmap <leader>Jb <action>(CompileDirty)
nmap <leader>Jw <action>(InvalidateCaches)

" --- Tests (<leader>T) ---

nmap <leader>Tn <action>(RunClass)
nmap <leader>Td <action>(DebugClass)
nmap <leader>Tf <action>(RunClass)
nmap <leader>Tl <action>(Rerun)
nmap <leader>Tx <action>(Stop)
nmap <leader>Ts <action>(ActivateRunToolWindow)
nmap <leader>To <action>(ActivateRunToolWindow)

" --- Debugging ---

nmap <F5> <action>(Resume)
nmap <F1> <action>(StepInto)
nmap <F2> <action>(StepOver)
nmap <F3> <action>(StepOut)
nmap <F7> <action>(ActivateDebugToolWindow)
nmap <leader>b <action>(ToggleLineBreakpoint)
nmap <leader>B <action>(EditBreakpoint)
nmap <leader>dp <action>(AddLoggingBreakpoint)
nmap <leader>dc <action>(RunToCursor)
nmap <leader>de <action>(EvaluateExpression)
vmap <leader>de <action>(EvaluateExpression)
nmap <leader>dr <action>(EvaluateExpression)
nmap <leader>da <action>(XDebugger.AttachToProcess)
nmap <leader>dl <action>(Debug)
nmap <leader>dx <action>(Stop)

" --- Run configurations and builds (<leader>r) ---

nmap <leader>rr <action>(ChooseRunConfiguration)
nmap <leader>rl <action>(Rerun)
nmap <leader>rx <action>(Stop)
nmap <leader>ro <action>(ActivateRunToolWindow)
nmap <leader>rm <action>(MakeModule)
nmap <leader>rp <action>(CompileDirty)
nmap <leader>rc <action>(Compile)
nmap <leader>rT <action>(RunClass)

" --- Server (<leader>w), uses the selected run configuration ---

nmap <leader>wd <action>(Debug)
nmap <leader>ws <action>(Run)
nmap <leader>wx <action>(Stop)
nmap <leader>wr <action>(Rerun)
nmap <leader>wb <action>(BuildArtifact)
nmap <leader>wl <action>(ActivateServicesToolWindow)
nmap <leader>wa <action>(XDebugger.AttachToProcess)
nmap <leader>ww <action>(ChooseRunConfiguration)

" --- Git (<leader>g, <leader>h) ---

nmap <leader>gs <action>(ActivateCommitToolWindow)
nmap <leader>gd <action>(ActivateCommitToolWindow)
nmap <leader>gr <action>(Git.CompareWithBranch)
nmap <leader>gm <action>(GitLab.Merge.Request.Show.List)
nmap <leader>gM <action>(GitLab.Merge.Request.Open.Link)
nmap <leader>gh <action>(Vcs.ShowTabbedFileHistory)
vmap <leader>gh <action>(Vcs.ShowHistoryForBlock)
nmap <leader>gH <action>(ActivateVersionControlToolWindow)
nmap <leader>gb <action>(Annotate)
nmap <leader>ga <action>(Git.Add)
nmap <leader>gc <action>(CheckinProject)
nmap <leader>gp <action>(Vcs.Push)
nmap <leader>gg <action>(Git.Menu)
nmap ]c <action>(VcsShowNextChangeMarker)
nmap [c <action>(VcsShowPrevChangeMarker)
nmap <leader>hp <action>(VcsShowCurrentChangeMarker)
nmap <leader>hr <action>(Vcs.RollbackChangedLines)
nmap <leader>hb <action>(Annotate)

" --- Database ---

nmap <leader>Du <action>(ActivateDatabaseToolWindow)

" --- which-key group names ---

let g:WhichKeyDesc_java = "<leader>J Java"
let g:WhichKeyDesc_test = "<leader>T Test"
let g:WhichKeyDesc_debug = "<leader>d Debug"
let g:WhichKeyDesc_run = "<leader>r Run"
let g:WhichKeyDesc_server = "<leader>w Server"
let g:WhichKeyDesc_git = "<leader>g Git"
let g:WhichKeyDesc_hunk = "<leader>h Git hunk"
let g:WhichKeyDesc_search = "<leader>s Search"
let g:WhichKeyDesc_toggle = "<leader>t Toggle"
let g:WhichKeyDesc_database = "<leader>D Database"

set NERDTree
let g:NERDTreeMapActivateNode=' '
let g:NERDTreeMapJumpParent='h'
let g:NERDTreeMapJumpParent='p'
