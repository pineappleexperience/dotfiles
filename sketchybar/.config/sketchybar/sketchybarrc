#!/usr/bin/env bash
# Replaces the macOS menu bar: AeroSpace workspaces and the active app on the left, development and system
# status on the right. Items that are not relevant at the moment hide themselves.

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/settings.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"
FONT="JetBrainsMono Nerd Font"

sketchybar --bar position=top \
	height=37 \
	color=0x00000000 \
	display=all \
	notch_width=200 \
	padding_left=8 \
	padding_right=8 \
	--default icon.font="$FONT:Bold:14.0" \
	icon.color="$TEXT" \
	label.font="$FONT:Regular:13.0" \
	label.color="$TEXT" \
	icon.padding_left=4 \
	icon.padding_right=4 \
	label.padding_left=4 \
	label.padding_right=4 \
	padding_left=3 \
	padding_right=3

# Left
source "$ITEM_DIR/workspaces.sh"
source "$ITEM_DIR/front_app.sh"

# Right, from the right edge inwards
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/audio_output.sh"
source "$ITEM_DIR/network.sh"
source "$ITEM_DIR/ram.sh"
source "$ITEM_DIR/servers.sh"
source "$ITEM_DIR/gitlab.sh"

# The bar is transparent, the two sides sit on rounded backgrounds that stay readable on any wallpaper
sketchybar --add bracket left_side '/workspace\..*/' front_app \
	--set left_side background.color="$PILL" background.corner_radius=10 background.height=30 \
	--add bracket right_side gitlab servers ram network audio_output volume battery clock \
	--set right_side background.color="$PILL" background.corner_radius=10 background.height=30

# Reload with the other colours when macOS switches between dark and light
sketchybar --add event theme_changed AppleInterfaceThemeChangedNotification \
	--add item theme left \
	--set theme drawing=off updates=on script="$PLUGIN_DIR/theme.sh" \
	--subscribe theme theme_changed

sketchybar --update
